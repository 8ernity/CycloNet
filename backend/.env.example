# ── CycloNet Application Settings ──────────────────────────────────────
APP_NAME=CycloNet
PORT=8000
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./cyclone_tracker.db

# ── Deep Learning Model ───────────────────────────────────────────────
MODEL_CHECKPOINT_PATH=app/models/cyclone_classifier.pth
DEVICE=cpu

# ── Google Gemini AI API Key ───────────────────────────────────────────
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ── CORS Configuration ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development only. Staging must use ENVIRONMENT=production, PostgreSQL,
# Redis and the same Clerk application as the frontend. Never commit real keys.
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
REDIS_FAIL_CLOSED=true
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
REQUIRE_VALIDATED_ML=false
# Proposed project; supplying this name does not enable satellite detection.
GEE_PROJECT_ID=cyclonet-ee-staging-8ernity
